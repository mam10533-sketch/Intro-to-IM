const int lanePins[4] = {2, 3, 4, 5};

const int LIGHT_THRESHOLD = 500;
const int PHOTO_INTERVAL  = 500;

bool lastLaneState[4] = {HIGH, HIGH, HIGH, HIGH};
bool lastLightMode    = true;
unsigned long lastPhotoCheck = 0;

void setup() {
  Serial.begin(9600);
  for (int i = 0; i < 4; i++) {
    pinMode(lanePins[i], INPUT_PULLUP);
  }
}

void loop() {
  unsigned long now = millis();

  for (int i = 0; i < 4; i++) {
    bool cur = digitalRead(lanePins[i]);
    if (cur == LOW && lastLaneState[i] == HIGH) {
      Serial.println(i + 1);
    }
    lastLaneState[i] = cur;
  }

  if (now - lastPhotoCheck >= PHOTO_INTERVAL) {
    lastPhotoCheck = now;
    int photoVal = analogRead(A0);
    bool isLight = (photoVal > LIGHT_THRESHOLD);
    if (isLight != lastLightMode) {
      lastLightMode = isLight;
      Serial.println(isLight ? "L" : "D");
    }
  }

  delay(10);
}
